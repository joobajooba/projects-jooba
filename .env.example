# WalletConnect Configuration
# Get a free project ID at https://cloud.reown.com/
# After creating a project:
# 1. Copy your Project ID
# 2. Add your domain (j00ba.xyz) to the Domain allowlist in project settings
# 3. Add this as VITE_WALLETCONNECT_PROJECT_ID in Netlify (Build & deploy → Environment).
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Supabase Configuration
# Get your anon key from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://jitkwbatwymqtlzxiyil.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alchemy API Keys (for NFT selector + wallet RPC)
# Get free keys at https://dashboard.alchemy.com/ (create app, enable Ethereum + ApeChain)
# Put .env in the repo root (same folder as package.json and vite.config.js).
# For Vercel: add these in Project → Settings → Environment Variables, then redeploy.

# One key for all networks (paste API key only, not the full URL):
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Or use separate keys per network (optional):
# VITE_ALCHEMY_API_KEY_ETH=your_ethereum_key
# VITE_ALCHEMY_API_KEY_APECHAIN=your_apechain_key
