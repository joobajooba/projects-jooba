# Supabase (Vite: prefix with VITE_ for client-side access)
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# WalletConnect (RainbowKit) — https://cloud.reown.com/
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Alchemy NFT API (ETH + ApeChain avatar picker) — https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# OpenSea API v2 (NFT Analysis page) — https://docs.opensea.io/reference/api-keys
# The app calls OpenSea via same-origin /api/opensea/* (Vite proxy in dev, Vercel serverless in prod)
# because api.opensea.io blocks browser CORS. Use VITE_ so the UI knows the key is set; the proxy
# reads VITE_OPENSEA_API_KEY or OPENSEA_API_KEY on the server.
VITE_OPENSEA_API_KEY=your_opensea_api_key_here
# Optional server-only duplicate on Vercel (same value): OPENSEA_API_KEY=...

# Vercel: Project → Settings → Environment Variables, then redeploy.
