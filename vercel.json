{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/implingz.js": {
      "maxDuration": 10
    },
    "api/dungeon-preview.js": {
      "includeFiles": "{api/_lib/**,scripts/**,dungeon_generator/**,Tiles/**,Tall Tiles/**,Mini-Bosses/**,tall_tiles/**}"
    },
    "api/keep.js": {
      "includeFiles": "{api/_lib/**}"
    },
    "api/keeps.js": {
      "includeFiles": "{api/_lib/**}"
    },
    "api/keep-v2.js": {
      "includeFiles": "{api/_lib/**}"
    }
  },
  "rewrites": [
    { "source": "/api/keep/:id", "destination": "/api/keep?id=:id" },
    { "source": "/api/keep-v2/:id", "destination": "/api/keep-v2?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
